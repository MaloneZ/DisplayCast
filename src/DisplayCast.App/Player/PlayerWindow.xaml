<Window x:Class="DisplayCast.Player.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DisplayCast 播放端"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        Background="Black"
        ShowInTaskbar="False"
        Cursor="None"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <MediaElement x:Name="VideoPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform"
                      Visibility="Collapsed"/>
        <wv2:WebView2 x:Name="WebPlayer" Visibility="Collapsed"/>
        <Image x:Name="ImagePlayer" Stretch="Uniform" Visibility="Collapsed"/>

        <TextBlock x:Name="Placeholder"
                   Foreground="White"
                   FontSize="28"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="等待控制端下发节目…"/>

        <!-- 关屏覆盖层（全黑，置于最上） -->
        <Rectangle x:Name="ScreenOffOverlay" Fill="Black" Visibility="Collapsed"/>
    </Grid>
</Window>
