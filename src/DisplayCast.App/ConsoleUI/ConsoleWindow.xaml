<Window x:Class="DisplayCast.ConsoleUI.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DisplayCast 播控控制台"
        Width="1240" Height="780"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Padding="12,10" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Background="#FAFAFA">
            <WrapPanel>
                <Button x:Name="ScanButton" Content="扫描设备" Click="ScanButton_Click" Padding="14,6" Margin="0,0,8,0"/>
                <Button x:Name="PushButton" Content="下发节目到选中设备" Click="PushButton_Click" Padding="14,6" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <Button x:Name="AddMediaButton" Content="导入图片/视频" Click="AddMediaButton_Click" Padding="14,6" Margin="0,0,8,0"/>
                <Button x:Name="AddWebButton" Content="添加网页" Click="AddWebButton_Click" Padding="14,6" Margin="0,0,8,0"/>
                <Button x:Name="SettingsButton" Content="设置" Click="SettingsButton_Click" Padding="14,6" Margin="8,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 设备列表 -->
            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="设备列表" FontWeight="SemiBold" Padding="12,10"/>
                    <ListView x:Name="DevicesList" Grid.Row="1" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4" Width="350">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="92" Height="54" Background="#222222" VerticalAlignment="Top">
                                        <Image Source="{Binding Preview}" Stretch="UniformToFill" Width="92" Height="54"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Group, StringFormat=〔{0}〕}" Foreground="#888888" FontSize="12" Margin="4,1,0,0"/>
                                            <TextBlock Text="{Binding Remark}" Foreground="#E65100" FontSize="12" Margin="6,1,0,0" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Remark}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Ip}" Foreground="#666666" FontSize="12"/>
                                            <TextBlock Text=" · " Foreground="#AAAAAA" FontSize="12"/>
                                            <TextBlock Text="{Binding Status}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#999999"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="在线">
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Volume, StringFormat=音量{0}}" Foreground="#666666" FontSize="12" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CurrentItem, StringFormat=正在播放：{0}}" Foreground="#999999" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 设备操作 -->
                    <Border Grid.Row="2" Padding="10,8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <Button x:Name="DeviceRemarkButton" Content="编辑备注" Click="DeviceRemarkButton_Click" Padding="10,4" Margin="0,0,6,4"/>
                                <Button x:Name="DeviceRemoteButton" Content="远程操作网页" Click="DeviceRemoteButton_Click" Padding="10,4" Margin="0,0,6,4"/>
                                <Button x:Name="DeviceNextButton" Content="下一首" Click="DeviceNextButton_Click" Padding="10,4" Margin="0,0,6,4"/>
                                <Button x:Name="DevicePrevButton" Content="上一首" Click="DevicePrevButton_Click" Padding="10,4" Margin="0,0,6,4"/>
                                <Button x:Name="DeviceScreenToggleButton" Content="开/关屏" Click="DeviceScreenToggleButton_Click" Padding="10,4" Margin="0,0,6,4"/>
                                <Button x:Name="VolumeDownButton" Content="音量-" Click="VolumeDownButton_Click" Padding="10,4" Margin="0,0,6,4"/>
                                <Button x:Name="VolumeUpButton" Content="音量+" Click="VolumeUpButton_Click" Padding="10,4" Margin="0,0,6,4"/>
                                <Button x:Name="DeviceRestartButton" Content="重启播放端" Click="DeviceRestartButton_Click" Padding="10,4" Margin="0,0,6,4"/>
                                <Button x:Name="EmergencyButton" Content="紧急插播" Click="EmergencyButton_Click" Padding="10,4" Margin="0,0,0,4" Foreground="#C62828"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="分组：" VerticalAlignment="Center" Foreground="#666666"/>
                                <TextBox x:Name="GroupBox" Width="120" Margin="4,0,6,0" Padding="4,2"/>
                                <Button x:Name="ApplyGroupButton" Content="应用到选中" Click="ApplyGroupButton_Click" Padding="10,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 素材库 -->
            <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="素材库" FontWeight="SemiBold" Padding="12,10"/>
                    <ListBox x:Name="LibraryList" Grid.Row="1" SelectionMode="Extended"
                             SelectionChanged="LibraryList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="#999999"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="10,8">
                        <Button x:Name="AddToPlaylistButton" Content="加入节目单 →" Click="AddToPlaylistButton_Click" Padding="10,5" Margin="0,0,0,6"/>
                        <Button x:Name="RemoveMediaButton" Content="删除选中素材" Click="RemoveMediaButton_Click" Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 节目单 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,4">
                    <TextBlock Text="节目单" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PlaylistCombo" Width="180" Margin="12,0,8,0" SelectionChanged="PlaylistCombo_SelectionChanged"/>
                    <Button x:Name="NewPlaylistButton" Content="新建" Click="NewPlaylistButton_Click" Padding="10,3" Margin="0,0,4,0"/>
                    <Button x:Name="DeletePlaylistButton" Content="删除" Click="DeletePlaylistButton_Click" Padding="10,3"/>
                    <TextBlock Text="顺序：" VerticalAlignment="Center" Margin="16,0,4,0" Foreground="#666666"/>
                    <ComboBox x:Name="OrderModeCombo" Width="90" SelectionChanged="OrderModeCombo_SelectionChanged">
                        <ComboBoxItem Content="顺序播放"/>
                        <ComboBoxItem Content="随机播放"/>
                    </ComboBox>
                </StackPanel>

                <ListBox x:Name="PlaylistBox" Grid.Row="2" Margin="12,0" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock Text="{Binding TypeLabel}" Foreground="#888888" FontSize="12" VerticalAlignment="Center" Width="34"/>
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" Width="320" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DurationSeconds, StringFormat={}{0} 秒}" Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,6,12,6">
                    <Button x:Name="PlaylistUpButton" Content="上移" Click="PlaylistUpButton_Click" Padding="10,3" Margin="0,0,4,0"/>
                    <Button x:Name="PlaylistDownButton" Content="下移" Click="PlaylistDownButton_Click" Padding="10,3" Margin="0,0,4,0"/>
                    <Button x:Name="PlaylistRemoveButton" Content="移除" Click="PlaylistRemoveButton_Click" Padding="10,3" Margin="0,0,4,0"/>
                    <Button x:Name="PlaylistClearButton" Content="清空" Click="PlaylistClearButton_Click" Padding="10,3" Margin="0,0,12,0"/>
                    <TextBlock Text="时长(秒)：" VerticalAlignment="Center" Foreground="#666666"/>
                    <TextBox x:Name="DurationBox" Width="60" Margin="4,0,6,0" Padding="4,2"/>
                    <Button x:Name="ApplyDurationButton" Content="应用" Click="ApplyDurationButton_Click" Padding="10,3"/>
                </StackPanel>

                <!-- 预览 -->
                <Border Grid.Row="4" Height="140" Margin="12,0,12,12" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="1">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                        <MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed"/>
                        <TextBlock x:Name="PreviewHint" Text="在左侧素材库选中素材可在此预览" Foreground="#999999"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Padding="12,6" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Background="#FAFAFA">
            <TextBlock x:Name="StatusText" Text="就绪" Foreground="#666666" FontSize="12"/>
        </Border>

        <!-- 密码锁定遮罩 -->
        <Grid x:Name="LockOverlay" Grid.RowSpan="3" Background="#F0FFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                <TextBlock Text="控制台已锁定" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <PasswordBox x:Name="LockPasswordBox" Margin="0,16,0,0" Padding="8,6" KeyDown="LockPasswordBox_KeyDown"/>
                <TextBlock x:Name="LockHint" Foreground="#C62828" FontSize="12" Margin="0,8,0,0" TextAlignment="Center"/>
                <Button x:Name="UnlockButton" Content="解锁" Click="UnlockButton_Click" Padding="20,6" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
