<Window x:Class="DisplayCast.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DisplayCast 首次设置"
        Width="440" Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <StackPanel Margin="26">
        <TextBlock Text="欢迎使用 DisplayCast" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="请选择这台设备的用途：" Margin="0,14,0,0"/>

        <RadioButton x:Name="PlayerRadio"
                     Content="播放端（显示设备，全屏播放）"
                     GroupName="Role"
                     IsChecked="True"
                     Margin="0,12,0,0"/>
        <RadioButton x:Name="ConsoleRadio"
                     Content="控制台（管理所有显示设备）"
                     GroupName="Role"
                     Margin="0,8,0,0"/>

        <TextBlock Text="设备名称" Margin="0,20,0,0"/>
        <TextBox x:Name="DeviceNameBox" Margin="0,6,0,0" Padding="6,4"/>

        <CheckBox x:Name="AutoStartBox" Content="开机自动启动" IsChecked="True" Margin="0,18,0,0"/>

        <Button x:Name="OkButton"
                Content="完成"
                HorizontalAlignment="Right"
                Margin="0,26,0,0"
                Padding="26,6"
                Click="OkButton_Click"/>
    </StackPanel>
</Window>
