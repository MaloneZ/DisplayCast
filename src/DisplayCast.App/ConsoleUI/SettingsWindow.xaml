<Window x:Class="DisplayCast.ConsoleUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="460" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <StackPanel Margin="24">
        <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"/>

        <TextBlock Text="设备名称" Margin="0,16,0,0"/>
        <TextBox x:Name="DeviceNameBox" Margin="0,6,0,0" Padding="6,4"/>

        <CheckBox x:Name="AutoStartBox" Content="开机自动启动" Margin="0,16,0,0"/>

        <!-- 播放端专属 -->
        <StackPanel x:Name="PlayerPanel" Margin="0,16,0,0">
            <TextBlock Text="实时预览截图间隔" />
            <ComboBox x:Name="PreviewIntervalCombo" Margin="0,6,0,0" Padding="6,4"/>

            <TextBlock Text="显示在哪个屏幕（0=主屏）" Margin="0,12,0,0"/>
            <TextBox x:Name="TargetScreenBox" Margin="0,6,0,0" Padding="6,4"/>

            <TextBlock Text="每日自动关屏时间（HH:mm，留空=不启用）" Margin="0,12,0,0"/>
            <TextBox x:Name="ScreenOffTimeBox" Margin="0,6,0,0" Padding="6,4"/>

            <TextBlock Text="每日自动开屏时间（HH:mm，留空=不启用）" Margin="0,12,0,0"/>
            <TextBox x:Name="ScreenOnTimeBox" Margin="0,6,0,0" Padding="6,4"/>
        </StackPanel>

        <!-- 控制台专属 -->
        <StackPanel x:Name="ConsolePanel" Margin="0,16,0,0">
            <TextBlock Text="控制台解锁密码（留空=无需密码）"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,6,0,0" Padding="6,4"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="取消" Padding="20,6" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="保存" Padding="20,6" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
