<Window x:Class="DisplayCast.ConsoleUI.WebControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程操作网页"
        Width="900" Height="720"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Padding="12,8" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Background="#FAFAFA">
            <WrapPanel>
                <TextBlock x:Name="TitleText" Text="远程操作" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="ReloadButton" Content="刷新页面" Click="ReloadButton_Click" Padding="12,5" Margin="0,0,6,0"/>
                <Button x:Name="BackButton" Content="后退" Click="BackButton_Click" Padding="12,5" Margin="0,0,6,0"/>
                <Button x:Name="ForwardButton" Content="前进" Click="ForwardButton_Click" Padding="12,5" Margin="0,0,6,0"/>
                <Button x:Name="JsButton" Content="执行 JS" Click="JsButton_Click" Padding="12,5" Margin="0,0,6,0"/>
                <TextBlock x:Name="HintText" Text="点击画面即可操作网页（需先在播放端切换到网页素材）" Foreground="#888888" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- 实时画面（可点击） -->
        <Border Grid.Row="1" Background="#1E1E1E" Margin="0">
            <Grid>
                <Image x:Name="RemoteImage" Stretch="Uniform" MouseLeftButtonDown="RemoteImage_MouseLeftButtonDown" Cursor="Hand"/>
                <TextBlock x:Name="LoadingText" Text="正在连接播放端…" Foreground="#AAAAAA" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 输入操作区 -->
        <Border Grid.Row="2" Padding="12,8" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Background="#FAFAFA">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="输入文本：" VerticalAlignment="Center" Foreground="#666666" FontSize="12"/>
                    <TextBox x:Name="InputBox" Width="360" Margin="6,0,6,0" Padding="6,4" KeyDown="InputBox_KeyDown"
                             ToolTip="先在上方画面点击要输入的输入框，再在此输入内容并点击发送"/>
                    <Button x:Name="SendInputButton" Content="发送到网页" Click="SendInputButton_Click" Padding="12,4" Margin="0,0,6,0"/>
                    <Button x:Name="EnterKeyButton" Content="回车(提交)" Click="EnterKeyButton_Click" Padding="12,4" Margin="0,0,6,0"/>
                    <Button x:Name="BackspaceButton" Content="退格" Click="BackspaceButton_Click" Padding="12,4"/>
                </StackPanel>
                <TextBlock Text="提示：关闭广告、登录等操作 = 在上方画面里直接点击对应位置；登录输入 = 先点输入框，再输入内容并发送，最后点「回车」。" 
                           Foreground="#999999" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
